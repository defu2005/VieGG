# HTTPS tự động (Let's Encrypt), web tĩnh và /api trên cùng một tên miền nên web không cần CORS.
# Đứng sau Cloudflare (đám mây cam): IP thật của khách lấy từ CF-Connecting-IP, chỉ khi request đến từ dải IP
# của Cloudflare (https://www.cloudflare.com/ips/), nên không ai giả được IP để lách giới hạn tần suất.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$RENTGG_DOMAIN} {
	encode zstd gzip

	# Nội bộ: số liệu, health chi tiết và tài liệu API không ra Internet.
	# (Trong handle để chạy trước khối web bên dưới; respond đứng riêng sẽ bị handle chạy trước.)
	@internal path /actuator /actuator/* /swagger-ui* /v3/api-docs*
	handle @internal {
		respond 404
	}

	handle /api/* {
		# Lớn nhất là video khiếu nại 20 MB.
		request_body {
			max_size 22MB
		}
		reverse_proxy app:8080 {
			# Một giá trị duy nhất: IP thật Caddy đã xác định (xem trusted_proxies ở trên).
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv/web
		# File trong /assets có hash trong tên nên cache lâu được (Cloudflare cũng cache theo header này).
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
