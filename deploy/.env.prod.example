# Sao thành .env.prod trên VPS rồi điền giá trị thật. KHÔNG commit .env.prod.
# Sinh secret ngẫu nhiên trên VPS:
#   openssl rand -base64 48                       (JWT secret, webhook secret, mật khẩu DB)
#   echo "k$(date +%Y%m):$(openssl rand -base64 32)"   (khóa mã hóa mật khẩu tài khoản game)

# ---- Tên miền (bản ghi A trỏ về IP VPS, xem docs/RentGG_Production_Deploy.md)
RENTGG_DOMAIN=rentgg.vn
ACME_EMAIL=ban@example.com

# ---- Database (chỉ dùng trong mạng nội bộ của compose)
DB_PASSWORD=

# ---- Bảo mật (ứng dụng từ chối khởi động nếu thiếu hoặc là giá trị dev)
RENTGG_JWT_SECRET=
# keyId:base64(32 byte). LƯU THÊM MỘT BẢN Ở NƠI AN TOÀN NGOÀI VPS: mất khóa này = mất toàn bộ mật khẩu tài khoản game.
RENTGG_CREDENTIAL_KEYS=
RENTGG_CREDENTIAL_ACTIVE_KEY_ID=
RENTGG_PAYMENT_WEBHOOK_SECRET=
RENTGG_CORS_ALLOWED_ORIGINS=https://rentgg.vn

# ---- Thanh toán (production: endpoint thật, KHÔNG phải sandbox)
RENTGG_PUBLIC_BASE_URL=https://rentgg.vn
RENTGG_FRONTEND_BASE_URL=https://rentgg.vn
RENTGG_PAYMENT_FAKE_ENABLED=false
RENTGG_PAYMENT_PROVIDER=PAYOS
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://pay.vnpay.vn/vpcpay.html
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://payment.momo.vn
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# ZALOPAY_ENDPOINT=https://openapi.zalopay.vn

# ---- Ảnh/video trên Cloudflare R2 (bucket "rentgg-media", token quyền Object Read & Write cho bucket này)
RENTGG_MEDIA_STORAGE=s3
RENTGG_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RENTGG_S3_BUCKET=rentgg-media
RENTGG_S3_ACCESS_KEY=
RENTGG_S3_SECRET_KEY=

# ---- Sao lưu DB lên R2 (bucket RIÊNG "rentgg-backup", token riêng)
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=rentgg-backup
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30
