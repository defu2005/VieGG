# Copy to .env. Docker Compose always passes these vars into the container,
# so they cannot be left empty even on profile `dev` (empty string overrides YAML defaults).
# Staging/prod refuse to start with these key ids / secrets (System Design §14.3).
SPRING_PROFILES_ACTIVE=dev
DB_PASSWORD=rentgg_dev
# base64, >= 32 bytes:  openssl rand -base64 48
RENTGG_JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1yZW50Z2ctMzItYnl0ZXMtbWluIQ==
# keyId:base64(32 bytes)[,keyId2:...]   e.g. k2026a:$(openssl rand -base64 32)
RENTGG_CREDENTIAL_KEYS=devkey:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
RENTGG_CREDENTIAL_ACTIVE_KEY_ID=devkey
# >= 32 characters
RENTGG_PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-rentgg-0123456789

# ---- Payment providers (wallet top-up). Each one is offered once its keys are set; endpoints default to sandboxes.
# RENTGG_PAYMENT_PROVIDER=FAKE            # default choice (FAKE|VNPAY|MOMO|ZALOPAY|PAYOS)
# RENTGG_PAYMENT_FAKE_ENABLED=true        # dev simulator; refused on prod
# RENTGG_PUBLIC_BASE_URL=http://localhost:8080   # backend URL the providers call back / redirect to
# RENTGG_FRONTEND_BASE_URL=http://localhost:5273 # where the payer lands afterwards
# VNPay sandbox (register free: https://sandbox.vnpayment.vn/devreg) — IPN URL: <public>/api/v1/payments/webhook/vnpay
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# MoMo sandbox (free business test account: https://business.momo.vn) — IPN URL is sent per request
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# ZaloPay sandbox (free: https://docs.zalopay.vn) — callback URL is sent per request
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# PayOS / VietQR (free account: https://my.payos.vn) — webhook URL: <public>/api/v1/payments/webhook/payos
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
